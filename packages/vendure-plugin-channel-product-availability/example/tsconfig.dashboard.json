{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "paths": {
            "@/gql": ["./gql/graphql.ts"],
            "@/vdb/*": ["../../../node_modules/@vendure/dashboard/src/lib/*"]
        }
    },
    "include": ["../src/dashboard/**/*", "gql/**/*.ts"]
}

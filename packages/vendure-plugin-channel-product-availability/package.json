{
  "name": "@rahul_vendure/vendure-plugin-channel-product-availability",
  "version": "1.0.0",
  "description": "Per-channel product enable/disable overrides for Vendure, enforced across catalog, search, cart and checkout",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dashboard": {
      "types": "./src/dashboard/index.tsx",
      "import": "./src/dashboard/index.tsx",
      "default": "./src/dashboard/index.tsx"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/dashboard/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "graphql-codegen --config codegen.yml",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run e2e",
    "test:e2e:postgres": "TEST_DB=postgres vitest run e2e",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@vendure/core": "^3.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.8",
    "@swc/core": "^1.13.5",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "channel",
    "multi-channel",
    "product-availability"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

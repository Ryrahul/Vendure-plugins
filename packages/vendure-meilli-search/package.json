{
  "name": "@rahul_vendure/vendure-meilli-search",
  "version": "3.0.1",
  "description": "Vendure plugin for Meilisearch-powered product search with AI hybrid (vector) search support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "meilisearch": "^0.62.0"
  },
  "peerDependencies": {
    "@vendure/common": "^3.0.0",
    "@vendure/core": "^3.0.0"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "meilisearch",
    "search",
    "full-text-search",
    "ai-search"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
